[
  {
    "id": "cn_num",
    "label": "中文数字章节",
    "pattern": "^第[一二三四五六七八九十百千零〇0-9]+[章节回折卷部]",
    "negativeFilters": ["图\\s*$", "表\\s*$"]
  },
  {
    "id": "cn_num_digit",
    "label": "第N章（阿拉伯数字）",
    "pattern": "^第\\d+[章节回折卷部]",
    "negativeFilters": []
  },
  {
    "id": "en_chapter",
    "label": "Chapter N",
    "pattern": "^[Cc]hapter\\s+\\d+",
    "negativeFilters": []
  },
  {
    "id": "en_volume",
    "label": "Volume N",
    "pattern": "^[Vv]olume\\s+\\d+",
    "negativeFilters": []
  },
  {
    "id": "ascii_num",
    "label": "数字编号 (1. 2、)",
    "pattern": "^\\d{1,3}[\\.、]\\s*\\S",
    "negativeFilters": ["^\\d{4}"]
  },
  {
    "id": "sep_title",
    "label": "分隔线标题",
    "pattern": "^[—\\-=]{4,}\\s*[章节卷]",
    "negativeFilters": []
  }
]
