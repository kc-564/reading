%% 阅读器 App 核心调用流程时序图（6 条主链路）
%% 见 docs/system_design.md §4

%% ── ① 打开书 → 恢复进度 → 排版（含缓存命中）──
sequenceDiagram
    participant U as User
    participant RS as ReaderScreen
    participant VM as ReaderViewModel
    participant Repo as BookRepository
    participant FP as FileFingerprint
    participant Cache as LayoutCache
    participant Pag as ReaderPagination
    participant Eng as LayoutEngine

    U->>RS: navigate("reader/{path}")
    RS->>VM: create(bookPath)
    VM->>Repo: getBook(path)
    alt 已有记录
        Repo-->>VM: BookEntity(lastChapter,lastOffset)
    else 新书
        VM->>Repo: upsertBook(BookEntity)
    end
    VM->>FP: fingerprint(path)
    VM->>Cache: get(key = fp + styleHash + screen)
    alt 缓存命中
        Cache-->>VM: 各章 pages
    else 未命中
        VM->>Pag: paginateBook(chapters, styleConfig, w, h)
        Pag->>Eng: paginate(chapterText, textStyle, w, h, cfg)
        Eng-->>Pag: List<PageInfo>
        Pag-->>VM: BookPagination(totalPages, perChapterCounts)
        VM->>Cache: put(key, pages)
    end
    VM->>VM: 计算 currentGlobalPage / globalPercent
    VM-->>RS: ReaderUiState.Ready(...)
    RS->>RS: pager 恢复到 currentGlobalPage

%% ── ② 改排版参数 → 实时重排（进度保持不跳开头）──
sequenceDiagram
    participant U as User
    participant SS as SettingsSheet
    participant Prefs as AppPrefs
    participant VM as ReaderViewModel
    participant Pag as ReaderPagination
    participant Eng as LayoutEngine
    participant RS as ReaderScreen

    U->>SS: 改 fontScale/lineSpacing/margin/theme
    SS->>Prefs: setX(...)
    Prefs-->>VM: styleConfig Flow 发射新值
    VM->>VM: 保留 currentChapterIndex + currentCharOffset
    VM->>Pag: paginateBook(chapters, newCfg, w, h)
    Pag->>Eng: paginate(...) 逐章分块
    Eng-->>Pag: pages
    VM->>VM: 由同一 charOffset 重算 globalPage
    VM-->>RS: Ready(updated pages, 同 offset)
    RS->>RS: 重排并滚动到同偏移页（不回第 0 页）

%% ── ③ 书签增删 ──
sequenceDiagram
    participant U as User
    participant BS as BookmarkSheet
    participant VM as ReaderViewModel
    participant Repo as BookmarkRepository

    U->>BS: 添加书签（当前页）
    BS->>VM: addBookmark(chapter, page, charOffset, preview)
    VM->>Repo: insert(BookmarkEntity)
    Repo-->>VM: done
    VM-->>BS: 刷新列表
    U->>BS: 删除书签
    BS->>VM: removeBookmark(id)
    VM->>Repo: delete(id)

%% ── ④ 全文搜索 → 跳转 ──
sequenceDiagram
    participant U as User
    participant SS as SearchSheet
    participant VM as ReaderViewModel
    participant SE as SearchEngine
    participant RS as ReaderScreen

    U->>SS: 输入关键词
    SS->>VM: search(q)
    VM->>SE: search(chapters, q)
    SE-->>VM: List<SearchHit(chapter,charOffset,preview)>
    VM-->>SS: 结果列表
    U->>SS: 点击某命中
    SS->>VM: jumpTo(chapter, charOffset)
    VM->>VM: 设置 currentChapterIndex + offset
    VM-->>RS: Ready(...) → pager 滚到目标页

%% ── ⑤ 批量导入 → 解析 → 入库 ──
sequenceDiagram
    participant U as User
    participant ID as ImportDialog
    participant IM as ImportManager
    participant AE as ArchiveExtractor
    participant ED as EncodingDetector
    participant Repo as BookRepository

    U->>ID: 选多文件/文件夹/zip,rar
    ID->>IM: importUris(uris)
    IM->>AE: extractArchivesIfNeeded()
    AE-->>IM: List<File> txt/epub
    loop 每个文件
        IM->>ED: detect(path, defaultPref)
        ED-->>IM: Charset
        IM->>Repo: upsertBook(BookEntity(format,size,encoding))
    end
    Repo-->>ID: 书籍已加入
    ID-->>U: 书架刷新

%% ── ⑥ WiFi 传书上传 → 入库 ──
sequenceDiagram
    participant PC as 浏览器(PC)
    participant WS as WifiServer(nanohttpd)
    participant VM as WifiTransferViewModel
    participant IM as ImportManager
    participant Repo as BookRepository

    PC->>WS: GET / → 上传页
    WS-->>PC: wifi_upload.html
    PC->>WS: POST /upload (multipart 文件)
    WS->>VM: onUpload(tempFile, name)
    VM->>IM: importFile(tempFile)
    IM->>Repo: upsertBook(...)
    VM-->>WS: 200 OK (json)
    WS-->>PC: 成功
    VM-->>Shelf: 刷新书架
