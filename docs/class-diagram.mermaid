classDiagram
    direction TB

    %% ── v1.1 新增 / 修改的核心类 ──

    class EpubParser {
        +parse(filePath, encoding) EpubParseResult
        -parseContainer(zip) String
        -parseOpf(zip, opfPath) EpubMetadata
        -extractCover(zip, manifest, opfDir) ByteArray?
        -parseSpine(zip, spine, manifest, opfDir) List~EpubChapter~
        -stripHtml(html) String
    }
    class EpubMetadata {
        +String title
        +String? author
        +String? coverImagePath
        +ByteArray? coverImageBytes
    }
    class EpubChapter {
        +String title
        +String content
        +int charCount
    }
    class EpubParseResult {
        +EpubMetadata metadata
        +List~EpubChapter~ chapters
    }

    EpubParser ..> EpubParseResult : returns
    EpubParseResult --> EpubMetadata
    EpubParseResult --> EpubChapter

    %% ── 导入系统（v1.1 扩展）──

    class ImportManager {
        -Context context
        -BookRepository repository
        -TxtParser txtParser
        -EpubParser epubParser
        +importFiles(paths) Int
        +importArchives(paths) Int
        -importTxt(path, encoding) BookEntity
        -importEpub(path, encoding) BookEntity
        -saveCoverImage(bookId, bytes) String
    }
    class ArchiveExtractor {
        +extract(paths) List~String~
        -extractZip(file, out)
        -extractRar(file, out)
    }
    class ImportDialog {
        +onDismiss()
        +onImported(count)
        -copyUriToCache(context, uri) String?
        -collectTreePaths(context, treeUri) List~String~
        -showProgress(visible)
    }

    ImportManager --> EpubParser : uses
    ImportManager ..> ArchiveExtractor : uses
    ImportDialog ..> ImportManager : calls

    %% ── 阅读器面板（v1.1 重构）──

    class ReaderScreen {
        -isPanelVisible Boolean
        -togglePanel()
        +ReaderScreen(bookPath, onNavigateBack)
    }
    class ReaderTopBar {
        +bookTitle String
        +onBack() Unit
        +onSearch() Unit
        +onBookmark() Unit
        +overflowMenuExpanded Boolean
    }
    class ReaderBottomBar {
        +chapterTitle String
        +onSunMenu() Unit
        +onPrevChapter() Unit
        +onNextChapter() Unit
        +onTypography() Unit
        +sunMenuExpanded Boolean
        +showTypographySheet Boolean
    }
    class ReaderContent {
        +state ReaderUiState.Ready
        +pagerState PagerState
        +styleConfig ReaderStyleConfig
        +onPanelToggle() Unit
        +isPanelVisible Boolean
    }

    ReaderScreen --> ReaderTopBar : contains
    ReaderScreen --> ReaderBottomBar : contains
    ReaderScreen --> ReaderContent : contains

    %% ── 导航（v1.1 重构）──

    class MainActivity {
        +onCreate(savedInstanceState)
        +ReaderNavigation()
        -currentTab Tab
    }
    class Tab {
        <<enum>>
        SHELF
        BOOKSTORE
        PROFILE
    }

    %% ── 新页面（v1.1 新增）──

    class ProfileScreen {
        +recentBooks List~BookEntity~
        +onNavigateToReader(bookPath)
        +onNavigateToStats()
        +onNavigateToSettings()
    }
    class SettingsScreen {
        +themeMode String
        +defaultFont String
        +onNavigateToTocRules()
        +onBack()
    }
    class TocRuleSettingsScreen {
        +enabledRules Set~String~
        +onToggleRule(ruleId, enabled)
        +onBack()
    }
    class BookStoreScreen {
    }

    %% ── 数据层（v1.1 扩展）──

    class ReadingHistoryDao {
        +getRecentHistoryFlow() Flow~List~
        +getDedupedRecentFlow() Flow~List~
        +upsertHistory(history)
        +deleteByBookId(bookId)
    }
    class BookRepository {
        +getDedupedRecentHistoryFlow() Flow~List~
        +saveCoverImage(context, bookId, bytes) String
    }
    class AppPrefs {
        +globalTocRules Flow~Set~String~~
        +setGlobalTocRules(rules)
        +defaultFont Flow~String~
        +setDefaultFont(key)
    }
    class BookEntity {
        +String bookId
        +String title
        +String? coverUri
        +String format
    }

    BookRepository --> ReadingHistoryDao : uses
    ProfileScreen ..> BookRepository : reads
    TocRuleSettingsScreen ..> AppPrefs : reads/writes

    %% ── TOC 迁移（v1.1）──

    class TocDrawer {
        +chapters List~Chapter~
        +currentChapterIndex Int
        +onChapterClick(idx)
    }

    %% ── 关系 ──

    MainActivity --> Tab : uses
    MainActivity --> ProfileScreen : hosts
    MainActivity --> SettingsScreen : hosts
    MainActivity --> BookStoreScreen : hosts
    SettingsScreen --> TocRuleSettingsScreen : navigates to
    ProfileScreen --> SettingsScreen : navigates to
